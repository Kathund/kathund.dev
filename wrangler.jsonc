{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "kathund-dev",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "disable_nodejs_process_v2"],
  "assets": { "binding": "ASSETS", "directory": "./build" },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kathund.dev", "custom_domain": true }]
}
