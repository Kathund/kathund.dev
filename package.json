{
  "name": "kathund.dev",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "prettier": "pnpm exec prettier --write .",
    "prettier:check": "pnpm exec prettier --check .",
    "eslint:check": "pnpm exec eslint . ",
    "eslint": "pnpm eslint:check --fix",
    "cloudflare:test": "pnpm build && pnpm wrangler dev",
    "cloudflare:deploy": "pnpm build && pnpm wrangler deploy",
    "check": "pnpm install --frozen-lockfile && pnpm prettier && pnpm eslint && pnpm build",
    "generate-types": "pnpm exec wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/svelte": "^9.0.1",
    "@catppuccin/tailwindcss": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "svelte": "^5.57.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/json": "^2.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.131.2"
  }
}
